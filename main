def quick_save(fig, name):
    SAVE_DIR.mkdir(parents=True, exist_ok=True)
    fig.savefig(SAVE_DIR / name, dpi=300, bbox_inches='tight', pad_inches=0.2)
    plt.close(fig)


def quick_save_data(df_data, name):
    SAVE_DIR.mkdir(parents=True, exist_ok=True)
    df_data.to_csv(SAVE_DIR / name, index=False, encoding='utf-8-sig')


# =========================================================================
# 【回归 SMOTE 引擎】
# =========================================================================
def generate_explicit_augmented_dataset(X_seed, y_seed, target_samples, p=0.4, alpha=0.6, beta=0.6, seed=42):
    """
    基于给定的训练种子集进行高维 Beta 插值增强，扩充至目标样本数。
    """
    np.random.seed(seed)
    current_samples = X_seed.shape[0]

    if current_samples >= target_samples:
        return X_seed, y_seed

    samples_to_add = target_samples - current_samples
    X_aug_list = [X_seed]
    y_aug_list = [y_seed]

    feature_stds = np.std(X_seed, axis=0) + 1e-6

    for _ in range(samples_to_add):
        idx_main = np.random.randint(0, current_samples)
        idx_permute = np.random.randint(0, current_samples)

        if np.random.rand() < p:
            lam = np.random.beta(alpha, beta) / 2 + 0.5
            new_x = lam * X_seed[idx_main] + (1 - lam) * X_seed[idx_permute]
            new_y = lam * y_seed[idx_main] + (1 - lam) * y_seed[idx_permute]
        else:
            noise_x = np.random.normal(0, 0.01, X_seed.shape[1]) * feature_stds
            new_x = X_seed[idx_main] + noise_x
            new_y = y_seed[idx_main]

        X_aug_list.append(new_x.reshape(1, -1))
        y_aug_list.append(new_y.reshape(1, -1))

    return np.vstack(X_aug_list), np.vstack(y_aug_list)


