import argparse
import json
import math
import sys
from pathlib import Path

import numpy as np
import pandas as pd
import torch
import torch.nn as nn
import torch.nn.functional as F
from sklearn.metrics import mean_absolute_error, mean_squared_error, r2_score
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from torch.utils.data import DataLoader, TensorDataset

try:
    import optuna
except ImportError:
    optuna = None


BASE_DIR = Path(__file__).resolve().parent
SAVE_DIR = BASE_DIR / "13(1)-TabNet_result"
SAVE_DIR.mkdir(parents=True, exist_ok=True)


def save_data(data, name):
    data.to_csv(SAVE_DIR / name, index=False, encoding="utf-8-sig")


def sparsemax(x, dim=-1):
    zs = torch.sort(x, descending=True, dim=dim)[0]
    range_tensor = torch.arange(
        1, x.size(dim) + 1, device=x.device, dtype=x.dtype
    ).view([1] * (x.dim() - 1) + [-1])
    bound = 1 + range_tensor * zs
    cumulative = torch.cumsum(zs, dim)
    is_gt = bound > cumulative
    k = is_gt.sum(dim=dim, keepdim=True).clamp(min=1)
    tau = (torch.gather(cumulative, dim, k - 1) - 1) / k
    return torch.clamp(x - tau, min=0)


class GLU(nn.Module):
    def __init__(self, inp, out, dropout_rate=0.45):
        super().__init__()
        self.fc = nn.Linear(inp, out * 2)
        self.bn = nn.BatchNorm1d(out * 2)
        self.drop = nn.Dropout(dropout_rate)
        self.out = out

    def forward(self, x):
        x = self.drop(self.bn(self.fc(x)))
        return x[:, :self.out] * torch.sigmoid(x[:, self.out:])


class FeatureTransformer(nn.Module):
    def __init__(self, input_dim, feature_dim, dropout_rate=0.45):
        super().__init__()
        self.first = GLU(input_dim, feature_dim, dropout_rate)
        self.shared1 = GLU(feature_dim, feature_dim, dropout_rate)
        self.shared2 = GLU(feature_dim, feature_dim, dropout_rate)
        self.scale = math.sqrt(0.5)

    def forward(self, x):
        x = self.first(x)
        x = (x + self.shared1(x)) * self.scale
        x = (x + self.shared2(x)) * self.scale
        return x


class AttentiveTransformer(nn.Module):
    def __init__(self, input_dim, output_dim):
        super().__init__()
        self.fc1 = nn.Linear(input_dim, 64)
        self.fc2 = nn.Linear(64, output_dim)
        self.bn = nn.BatchNorm1d(output_dim)

    def forward(self, prior, a):
        return sparsemax(self.bn(self.fc2(F.relu(self.fc1(a))))) * prior


class BalancedTabNet(nn.Module):
    def __init__(
        self,
        input_dim,
        n_d=32,
        n_a=32,
        n_steps=3,
        gamma=1.2,
        dropout_rate=0.45,
    ):
        super().__init__()
        self.n_d = n_d
        self.n_a = n_a
        self.n_steps = n_steps
        self.gamma = gamma
        self.input_dim = input_dim
        self.initial_bn = nn.BatchNorm1d(input_dim)
        self.feature_transformers = nn.ModuleList([
            FeatureTransformer(input_dim, n_d + n_a, dropout_rate)
            for _ in range(n_steps)
        ])
        self.att_transformers = nn.ModuleList([
            AttentiveTransformer(n_a, input_dim)
            for _ in range(n_steps)
        ])
        self.reg_fc1 = nn.Linear(n_d, 64)
        self.reg_bn1 = nn.BatchNorm1d(64)
        self.reg_fc2 = nn.Linear(64, 32)
        self.reg_dropout = nn.Dropout(p=dropout_rate)
        self.reg_fc3 = nn.Linear(32, 1)

    def forward(self, x):
        x = self.initial_bn(x)
        batch_size = x.size(0)
        prior = torch.ones(batch_size, self.input_dim, device=x.device)
        a = torch.zeros(batch_size, self.n_a, device=x.device)
        out = torch.zeros(batch_size, self.n_d, device=x.device)
        masks = []
        entropy_loss = torch.zeros((), device=x.device)
        for step in range(self.n_steps):
            mask = self.att_transformers[step](prior, a)
            masks.append(mask)
            entropy_loss = entropy_loss + (
                -mask * torch.log(mask + 1e-8)
            ).sum(1).mean()
            prior = torch.clamp(prior * (self.gamma - mask), min=0.05)
            transformed = self.feature_transformers[step](mask * x)
            d = F.relu(transformed[:, :self.n_d])
            a = transformed[:, self.n_d:]
            out = out + d
        result = F.leaky_relu(self.reg_bn1(self.reg_fc1(out)))
        result = F.leaky_relu(self.reg_fc2(result))
        result = self.reg_dropout(result)
        prediction = self.reg_fc3(result)
        return prediction, entropy_loss / self.n_steps, masks


class AdaptivePhysicsLoss(nn.Module):
    def __init__(
        self,
        monotonic_indices,
        lambda_min=1e-6,
        lambda_max=3e-3,
        ema_beta=0.98,
        response_power=2.0,
        sparse_weight=5e-5,
    ):
        super().__init__()
        self.mse = nn.MSELoss()
        self.monotonic_indices = tuple(monotonic_indices)
        self.lambda_min = float(lambda_min)
        self.lambda_max = float(lambda_max)
        self.ema_beta = float(ema_beta)
        self.response_power = float(response_power)
        self.sparse_weight = float(sparse_weight)
        self.ema_data_loss = None
        self.initial_ema_data_loss = None
        self.current_weight = self.lambda_min

    def monotonicity_penalty(self, x, pred, create_graph=True):
        gradients = torch.autograd.grad(
            pred.sum(),
            x,
            create_graph=create_graph,
            retain_graph=create_graph,
        )[0]
        return torch.stack([
            torch.mean(F.relu(gradients[:, index]))
            for index in self.monotonic_indices
        ]).sum()

    def update_weight(self, data_loss_value):
        value = float(data_loss_value)
        if self.ema_data_loss is None:
            self.ema_data_loss = value
            self.initial_ema_data_loss = max(value, 1e-12)
        else:
            self.ema_data_loss = (
                self.ema_beta * self.ema_data_loss
                + (1.0 - self.ema_beta) * value
            )
        improvement = np.clip(
            1.0 - self.ema_data_loss / self.initial_ema_data_loss,
            0.0,
            1.0,
        )
        self.current_weight = (
            self.lambda_min
            + (self.lambda_max - self.lambda_min)
            * float(improvement) ** self.response_power
        )

    def forward(self, x, pred, target, entropy, update_weight=True):
        data_loss = self.mse(pred, target)
        monotonicity_loss = self.monotonicity_penalty(
            x, pred, create_graph=True
        )
        if update_weight:
            self.update_weight(data_loss.detach().item())
        total_loss = (
            data_loss
            + self.current_weight * monotonicity_loss
            + self.sparse_weight * entropy
        )
        return total_loss, data_loss, monotonicity_loss, self.current_weight


def validation_score(model, criterion, x_tensor, y_tensor, device):
    model.eval()
    x_validation = x_tensor.to(device).detach().clone().requires_grad_(True)
    y_validation = y_tensor.to(device)
    prediction, entropy, _ = model(x_validation)
    data_loss = criterion.mse(prediction, y_validation)
    monotonicity_loss = criterion.monotonicity_penalty(
        x_validation, prediction, create_graph=False
    )
    score = (
        data_loss
        + criterion.current_weight * monotonicity_loss
        + criterion.sparse_weight * entropy
    )
    return float(score.detach().cpu())


def tune_model(
    X_train_tensor,
    y_train_tensor,
    X_validation_tensor,
    y_validation_tensor,
    input_dim,
    monotonic_indices,
    device,
    random_seed,
    n_trials,
    tune_epochs,
    batch_size,
):
    if optuna is None:
        raise ImportError("pip install optuna")

    optuna.logging.set_verbosity(optuna.logging.WARNING)

    def objective(trial):
        trial_seed = random_seed + trial.number
        np.random.seed(trial_seed)
        torch.manual_seed(trial_seed)
        if torch.cuda.is_available():
            torch.cuda.manual_seed_all(trial_seed)

        params = {
            "n_d": trial.suggest_categorical("n_d", [16, 32, 64, 128]),
            "n_a": trial.suggest_categorical("n_a", [16, 32, 64, 128]),
            "n_steps": trial.suggest_int("n_steps", 3, 6),
            "gamma": trial.suggest_float("gamma", 1.1, 1.8),
            "dropout_rate": trial.suggest_float(
                "dropout_rate", 0.10, 0.50
            ),
        }
        max_lr = trial.suggest_float("max_lr", 1e-3, 1e-2, log=True)
        weight_decay = trial.suggest_float(
            "weight_decay", 1e-6, 1e-3, log=True
        )

        model = BalancedTabNet(input_dim=input_dim, **params).to(device)
        criterion = AdaptivePhysicsLoss(monotonic_indices)
        optimizer = torch.optim.AdamW(
            model.parameters(),
            lr=max_lr / 10.0,
            weight_decay=weight_decay,
        )
        generator = torch.Generator().manual_seed(trial_seed)
        loader = DataLoader(
            TensorDataset(X_train_tensor, y_train_tensor),
            batch_size=batch_size,
            shuffle=True,
            generator=generator,
        )
        scheduler = torch.optim.lr_scheduler.OneCycleLR(
            optimizer,
            max_lr=max_lr,
            steps_per_epoch=len(loader),
            epochs=tune_epochs,
        )

        best_score = float("inf")
        no_improvement = 0

        for epoch in range(tune_epochs):
            model.train()
            for batch_x, batch_y in loader:
                batch_x = batch_x.to(device).requires_grad_(True)
                batch_y = batch_y.to(device)
                prediction, entropy, _ = model(batch_x)
                loss, _, _, _ = criterion(
                    batch_x,
                    prediction,
                    batch_y,
                    entropy,
                    update_weight=True,
                )
                optimizer.zero_grad(set_to_none=True)
                loss.backward()
                optimizer.step()
                scheduler.step()

            if epoch % 10 == 0 or epoch == tune_epochs - 1:
                score = validation_score(
                    model,
                    criterion,
                    X_validation_tensor,
                    y_validation_tensor,
                    device,
                )
                trial.report(score, epoch)
                if trial.should_prune():
                    raise optuna.TrialPruned()
                if score < best_score - 1e-7:
                    best_score = score
                    no_improvement = 0
                else:
                    no_improvement += 10
                if no_improvement >= 50:
                    break

        del model, optimizer, scheduler
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
        return best_score

    study = optuna.create_study(
        direction="minimize",
        sampler=optuna.samplers.TPESampler(seed=random_seed),
        pruner=optuna.pruners.MedianPruner(
            n_startup_trials=5, n_warmup_steps=50
        ),
    )
    study.optimize(objective, n_trials=n_trials, show_progress_bar=True)
    save_data(study.trials_dataframe(), "bayesian_optimization_trials.csv")
    best_params = dict(study.best_params)
    with open(
        SAVE_DIR / "bayesian_best_parameters.json",
        "w",
        encoding="utf-8",
    ) as file:
        json.dump(
            {
                "best_validation_composite_loss": study.best_value,
                **best_params,
            },
            file,
            ensure_ascii=False,
            indent=2,
        )
    return best_params


def inverse_target(prediction, scaler_y):
    prediction_log = scaler_y.inverse_transform(prediction)
    return np.maximum(10 ** prediction_log - 1e-4, 0.0)


def calculate_metrics(actual, predicted):
    actual = np.asarray(actual).reshape(-1)
    predicted = np.asarray(predicted).reshape(-1)
    return {
        "N": int(len(actual)),
        "R2": float(r2_score(actual, predicted)),
        "RMSE": float(np.sqrt(mean_squared_error(actual, predicted))),
        "MAE": float(mean_absolute_error(actual, predicted)),
    }


def prediction_table(actual, predicted, X, feature_names, split_name):
    table = pd.DataFrame({
        "Split": split_name,
        "Actual": np.asarray(actual).reshape(-1),
        "Predicted": np.asarray(predicted).reshape(-1),
    })
    table["Residual"] = table["Predicted"] - table["Actual"]
    table["RelativeErrorPercent"] = (
        np.abs(table["Residual"]) / (table["Actual"] + 1e-12) * 100
    )
    for index, name in enumerate(feature_names):
        table[name] = X[:, index]
    return table


def train_model(
    X_raw,
    y_raw,
    feature_names,
    test_size=0.25,
    validation_size=0.20,
    random_seed=42,
    n_trials=20,
    tune_epochs=300,
):
    np.random.seed(random_seed)
    torch.manual_seed(random_seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(random_seed)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    y_log = np.log10(y_raw + 1e-4)

    X_train_pool, X_test, y_train_pool, y_test_log = train_test_split(
        X_raw,
        y_log,
        test_size=test_size,
        random_state=random_seed,
    )
    X_train, X_validation, y_train_log, y_validation_log = train_test_split(
        X_train_pool,
        y_train_pool,
        test_size=validation_size,
        random_state=random_seed,
    )

    scaler_X = StandardScaler()
    scaler_y = StandardScaler()
    X_train_scaled = scaler_X.fit_transform(X_train)
    y_train_scaled = scaler_y.fit_transform(y_train_log)
    X_validation_scaled = scaler_X.transform(X_validation)
    y_validation_scaled = scaler_y.transform(y_validation_log)
    X_test_scaled = scaler_X.transform(X_test)

    X_train_tensor = torch.tensor(X_train_scaled, dtype=torch.float32)
    y_train_tensor = torch.tensor(y_train_scaled, dtype=torch.float32)
    X_validation_tensor = torch.tensor(
        X_validation_scaled, dtype=torch.float32
    )
    y_validation_tensor = torch.tensor(
        y_validation_scaled, dtype=torch.float32
    )
    X_test_tensor = torch.tensor(X_test_scaled, dtype=torch.float32)

    monotonic_features = ["Voltage", "Temperature", "Frequency"]
    monotonic_indices = [
        feature_names.index(name) for name in monotonic_features
    ]
    batch_size = min(256, len(X_train))

    best_params = tune_model(
        X_train_tensor,
        y_train_tensor,
        X_validation_tensor,
        y_validation_tensor,
        len(feature_names),
        monotonic_indices,
        device,
        random_seed,
        n_trials,
        tune_epochs,
        batch_size,
    )

    max_lr = float(best_params.pop("max_lr"))
    weight_decay = float(best_params.pop("weight_decay"))
    generator = torch.Generator().manual_seed(random_seed)
    train_loader = DataLoader(
        TensorDataset(X_train_tensor, y_train_tensor),
        batch_size=batch_size,
        shuffle=True,
        generator=generator,
    )

    model = BalancedTabNet(
        input_dim=len(feature_names), **best_params
    ).to(device)
    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=max_lr / 10.0,
        weight_decay=weight_decay,
    )
    epochs = 3500
    scheduler = torch.optim.lr_scheduler.OneCycleLR(
        optimizer,
        max_lr=max_lr,
        steps_per_epoch=len(train_loader),
        epochs=epochs,
    )
    criterion = AdaptivePhysicsLoss(monotonic_indices)
    best_validation_score = float("inf")
    checkpoint = SAVE_DIR / "best_tabnet_validation.pth"

    with open(
        SAVE_DIR / "final_training_configuration.json",
        "w",
        encoding="utf-8",
    ) as file:
        json.dump(
            {
                "model_parameters": best_params,
                "max_learning_rate": max_lr,
                "weight_decay": weight_decay,
                "batch_size": batch_size,
                "epochs": epochs,
                "monotonic_features": monotonic_features,
            },
            file,
            ensure_ascii=False,
            indent=2,
        )

    for epoch in range(epochs):
        model.train()
        epoch_loss = 0.0

        for batch_x, batch_y in train_loader:
            batch_x = batch_x.to(device).requires_grad_(True)
            batch_y = batch_y.to(device)
            prediction, entropy, _ = model(batch_x)
            loss, data_loss, _, physics_weight = criterion(
                batch_x,
                prediction,
                batch_y,
                entropy,
                update_weight=True,
            )
            optimizer.zero_grad(set_to_none=True)
            loss.backward()
            optimizer.step()
            scheduler.step()
            epoch_loss += data_loss.item()

        if epoch % 50 == 0 or epoch == epochs - 1:
            model.eval()
            with torch.no_grad():
                train_scaled_prediction, _, _ = model(
                    X_train_tensor.to(device)
                )
                validation_scaled_prediction, _, _ = model(
                    X_validation_tensor.to(device)
                )

            train_prediction = inverse_target(
                train_scaled_prediction.cpu().numpy(), scaler_y
            )
            validation_prediction = inverse_target(
                validation_scaled_prediction.cpu().numpy(), scaler_y
            )
            train_actual = 10 ** y_train_log - 1e-4
            validation_actual = 10 ** y_validation_log - 1e-4
            train_r2 = r2_score(train_actual, train_prediction)
            validation_r2 = r2_score(
                validation_actual, validation_prediction
            )
            score = validation_score(
                model,
                criterion,
                X_validation_tensor,
                y_validation_tensor,
                device,
            )
            if score < best_validation_score:
                best_validation_score = score
                torch.save(model.state_dict(), checkpoint)
            print(
                f"Epoch {epoch:4d}/{epochs} | "
                f"Train MSE: {epoch_loss / len(train_loader):.6f} | "
                f"Train R2: {train_r2:.4f} | "
                f"Validation R2: {validation_r2:.4f} | "
                f"Validation composite: {score:.6f} | "
                f"lambda_mono: {physics_weight:.6g}"
            )

    model.load_state_dict(torch.load(checkpoint, map_location=device))
    model.eval()

    with torch.no_grad():
        train_scaled_prediction, _, _ = model(X_train_tensor.to(device))
        validation_scaled_prediction, _, _ = model(
            X_validation_tensor.to(device)
        )
        test_scaled_prediction, _, _ = model(X_test_tensor.to(device))

    train_prediction = inverse_target(
        train_scaled_prediction.cpu().numpy(), scaler_y
    )
    validation_prediction = inverse_target(
        validation_scaled_prediction.cpu().numpy(), scaler_y
    )
    test_prediction = inverse_target(
        test_scaled_prediction.cpu().numpy(), scaler_y
    )

    train_actual = 10 ** y_train_log - 1e-4
    validation_actual = 10 ** y_validation_log - 1e-4
    test_actual = 10 ** y_test_log - 1e-4

    metrics = {
        "Train": calculate_metrics(train_actual, train_prediction),
        "Validation": calculate_metrics(
            validation_actual, validation_prediction
        ),
        "Test": calculate_metrics(test_actual, test_prediction),
    }

    train_table = prediction_table(
        train_actual,
        train_prediction,
        X_train,
        feature_names,
        "Train",
    )
    validation_table = prediction_table(
        validation_actual,
        validation_prediction,
        X_validation,
        feature_names,
        "Validation",
    )
    test_table = prediction_table(
        test_actual,
        test_prediction,
        X_test,
        feature_names,
        "Test",
    )

    save_data(train_table, "train_predictions.csv")
    save_data(validation_table, "validation_predictions.csv")
    save_data(test_table, "test_predictions.csv")
    save_data(
        pd.concat(
            [train_table, validation_table, test_table],
            ignore_index=True,
        ),
        "all_predictions.csv",
    )

    with open(
        SAVE_DIR / "final_metrics.json",
        "w",
        encoding="utf-8",
    ) as file:
        json.dump(metrics, file, ensure_ascii=False, indent=2)

    torch.save(
        {
            "state_dict": model.state_dict(),
            "model_parameters": best_params,
            "feature_names": feature_names,
            "scaler_X_mean": scaler_X.mean_,
            "scaler_X_scale": scaler_X.scale_,
            "scaler_y_mean": scaler_y.mean_,
            "scaler_y_scale": scaler_y.scale_,
        },
        SAVE_DIR / "final_tabnet_model.pth",
    )

    print(pd.DataFrame(metrics).T.to_string())


if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--test-size", type=float, default=0.25)
    parser.add_argument("--validation-size", type=float, default=0.20)
    parser.add_argument("--n-trials", type=int, default=20)
    parser.add_argument("--tune-epochs", type=int, default=300)
    args = parser.parse_args()

    data_path = Path(__file__).resolve().parent / "PI-data.CSV"
    if not data_path.exists():
        raise FileNotFoundError("PI-data.CSV")

    data = pd.read_csv(data_path)
    features = [
        "Voltage",
        "Temperature",
        "Frequency",
        "Maximum amplitude",
        "Average amplitude",
        "Number of times",
    ]
    target = "Life"
    missing_columns = [
        column
        for column in features + [target]
        if column not in data.columns
    ]
    if missing_columns:
        raise ValueError(f"Missing columns: {missing_columns}")

    model_data = data[features + [target]].copy()
    for column in model_data.columns:
        model_data[column] = pd.to_numeric(
            model_data[column], errors="coerce"
        )
    if model_data.isna().any().any():
        bad_columns = model_data.columns[
            model_data.isna().any()
        ].tolist()
        raise ValueError(f"Invalid columns: {bad_columns}")
    if (model_data[target] <= 0).any():
        raise ValueError("Life must be greater than zero")

    X = model_data[features].to_numpy(dtype=float)
    y = model_data[[target]].to_numpy(dtype=float)

    train_model(
        X,
        y,
        features,
        test_size=args.test_size,
        validation_size=args.validation_size,
        random_seed=42,
        n_trials=args.n_trials,
        tune_epochs=args.tune_epochs,
    )
    sys.exit(0)
