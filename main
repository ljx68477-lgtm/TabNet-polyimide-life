if __name__ == "__main__":
    current_dir = Path(__file__).resolve().parent
    data_file_name = "augmented_data_300.csv"
    data_path = current_dir / data_file_name

    if not data_path.exists():
        csv_files = list(current_dir.glob("*.csv"))
        if csv_files:
            data_path = csv_files[0]
        else:
            sys.exit(1)

    df_data = pd.read_csv(data_path)

    target_col = None
    feature_cols = []
    for col in df_data.columns:
        if any(keyword in col.lower() for keyword in ['life', '寿', '击穿时间']):
            target_col = col
        elif any(keyword in col.lower() for keyword in ['voltage', '电', 'temperature', '温', 'frequency', '频']):
            feature_cols.append(col)

    if target_col is None or len(feature_cols) < 3:
        feature_cols = list(df_data.columns[:3])
        target_col = df_data.columns[-1]

    X_raw = df_data[feature_cols].values
    y_raw = df_data[[target_col]].values

    print("--------------------------------------------------")
    print("⚡ 启动高说服力学术内核：训练集显式增强 + 测试集100%物理真实验证...")
    print("--------------------------------------------------")

    train_model(X_raw, y_raw, feature_cols, target_col)
    sys.exit(0)
